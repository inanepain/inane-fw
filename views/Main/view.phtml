<?php

declare(strict_types = 1);

use Inane\View\HtmlView;

/**
 * @var HtmlView $this
 * @var string   $qrCode
 * @var string   $image
 * @var string   $item
 */

?>
<quick-header textalign='left' colour='purple' left='0' underline linecolour='blueviolet' linewidth='90%' linealign='right' size='36'>Item: <?=$this->escape($item)?></quick-header>
<?php if (($image ?? '') !== ''): ?>
    <img width="300" src="<?=$this->escape($image)?>" alt="<?=$this->escape($item)?>">
<?php else: ?>
    <p>No image is available for this item.</p>
<?php endif; ?>
<?php if (($qrCode ?? '') !== ''): ?>
    <h3>Item QR code</h3>
    <img width="200" src="<?=$this->escape($qrCode)?>" alt="QR code for this item">
<?php endif; ?>
