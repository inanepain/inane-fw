<?php
/** @var \Inane\View\Model\HttpModel $this */

declare(strict_types=1);
/** @var string $item */
?>
<h2>Item: <?= $this->escape($item) ?></h2>
<?php if (($image ?? '') !== ''): ?>
    <img width="300" src="<?= $this->escape($image) ?>" alt="<?= $this->escape($item) ?>">
<?php else: ?>
    <p>No image is available for this item.</p>
<?php endif; ?>
<?php if (($qrcode ?? '') !== ''): ?>
    <h3>Item QR code</h3>
    <img width="200" src="<?= $this->escape($qrcode) ?>" alt="QR code for this item">
<?php endif; ?>
